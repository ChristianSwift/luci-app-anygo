#!/bin/sh /etc/rc.common
# Supervise the AnyGo worker and its USB helper.
USE_PROCD=1
START=95
STOP=10

NATIVE=/opt/anygo/native
DATA=/opt/anygo/data
RUN=/var/run/anygo

start_service() {
	local python="$NATIVE/python-3.12.16/bin/python3.12"
	local worker="$NATIVE/anygo_worker.py"
	local usb="$NATIVE/usb/usr/sbin/usbmuxd"
	local usb_socket=/var/run/usbmuxd

	# 首次安装尚未 anygo-setup 时不要让 start 失败，否则 opkg/LuCI 会把配置阶段标成错误
	if [ ! -x "$python" ] || [ ! -r "$worker" ]; then
		logger -t anygo "native runtime missing; run anygo-setup"
		return 0
	fi
	[ -c /dev/net/tun ] || {
		logger -t anygo "/dev/net/tun is unavailable; install kmod-tun"
		return 0
	}

	umask 077
	mkdir -p "$DATA" "$RUN" || return 1
	chmod 700 "$RUN" || return 1

	if [ -x "$usb" ]; then
		usb_socket="$RUN/usbmuxd.sock"
		procd_open_instance usbmuxd
		procd_set_param command "$usb" -f -S "$usb_socket" -P "$RUN/usbmuxd.pid"
		procd_set_param env "LD_LIBRARY_PATH=$NATIVE/usb/usr/lib" "USBMUXD_SOCKET_ADDRESS=UNIX:$usb_socket"
		procd_set_param respawn 3600 5 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi

	procd_open_instance worker
	procd_set_param command "$python" -B "$worker"
	procd_set_param env "HOME=$DATA" "ANYGO_DATA=$DATA" "ANYGO_SOCKET=$RUN/worker.sock" "USBMUXD_SOCKET_ADDRESS=$usb_socket"
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 12
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
