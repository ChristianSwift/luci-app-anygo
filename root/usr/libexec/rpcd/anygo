#!/bin/sh
# rpcd plugin: bridges LuCI/ubus to anygo-worker over its Unix socket.
# The worker is the only component that talks to the iPhone.

BASE="http://localhost"
SOCKET="${ANYGO_SOCKET:-/var/run/anygo/worker.sock}"

request() {
	curl -sS --noproxy '*' --max-time 40 --unix-socket "$SOCKET" "$@"
}

json_or_error() {
	if [ -n "$1" ]; then
		printf '%s' "$1"
	else
		printf '{"error":"worker unreachable"}'
	fi
}

case "$1" in
list)
	cat <<'EOF'
{
	"status": {},
	"config_get": {},
	"config_set": { "amap_key": "", "default_speed": 0.0, "max_devices": 0 },
	"pair_import": { "name": "", "data": "" },
	"pair_usb": {},
	"pair_delete": { "udid": "" },
	"connect": { "udid": "" },
	"disconnect": { "udid": "" },
	"set_location": { "udids": [], "lat": 0.0, "lon": 0.0 },
	"clear_location": { "udids": [] },
	"route_start": { "udids": [], "points": [], "speed": 0.0, "loop": false },
	"route_control": { "id": "", "action": "" },
	"get_logs": {}
}
EOF
	;;
call)
	method="$2"
	read -r input

	case "$method" in
	status)          out=$(request "$BASE/api/status") ;;
	config_get)      out=$(request "$BASE/api/config") ;;
	config_set)      out=$(request -X POST -H 'Content-Type: application/json' -d "$input" "$BASE/api/config") ;;
	pair_import)     out=$(request -X POST -H 'Content-Type: application/json' -d "$input" "$BASE/api/pair/import") ;;
	pair_usb)        out=$(request -X POST "$BASE/api/pair/usb") ;;
	pair_delete)
		udid=$(printf '%s' "$input" | jsonfilter -e '@.udid' 2>/dev/null)
		out=$(request -X DELETE "$BASE/api/pair/$udid")
		;;
	connect)         out=$(request -X POST -H 'Content-Type: application/json' -d "$input" "$BASE/api/connect") ;;
	disconnect)      out=$(request -X POST -H 'Content-Type: application/json' -d "$input" "$BASE/api/disconnect") ;;
	set_location)    out=$(request -X POST -H 'Content-Type: application/json' -d "$input" "$BASE/api/location") ;;
	clear_location)  out=$(request -X POST -H 'Content-Type: application/json' -d "$input" "$BASE/api/clear") ;;
	route_start)     out=$(request -X POST -H 'Content-Type: application/json' -d "$input" "$BASE/api/route_start") ;;
	route_control)   out=$(request -X POST -H 'Content-Type: application/json' -d "$input" "$BASE/api/route_control") ;;
	get_logs)        out=$(request "$BASE/api/logs?lines=120") ;;
	*)               out='{"error":"unknown method"}' ;;
	esac

	json_or_error "$out"
	;;
*)
	echo '{"error":"usage: anygo {list|call}"}'
	;;
esac
